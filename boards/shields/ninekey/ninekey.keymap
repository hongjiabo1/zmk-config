#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    combos {
        compatible = "zmk,combos";

        // Fixed physical-position shortcut; remains available after Studio remapping.
        studio_unlock_combo {
            timeout-ms = <50>;
            key-positions = <0 2>; // K1 + K3
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N1  &kp N2  &kp N3
                &kp N4  &kp N5  &kp N6
                &kp N7  &kp N8
            >;
        };
    };
};
