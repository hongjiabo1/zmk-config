#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/bluetooth.dtsi>
#include <physical_layouts.dtsi>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";

        input-gpios
            = <&pro_micro 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    // Keep K9 outside the mutable keymap. This wraps the unchanged direct scanner.
    ninekey_scan: ninekey_scan {
        compatible = "zmk,kscan-sideband-behaviors";
        kscan = <&kscan0>;

        rear_bluetooth_clear {
            row = <0>;
            column = <8>;
            bindings = <&bt BT_CLR>;
        };
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <1>;
        columns = <9>;

        map = <
            RC(0,0) RC(0,1) RC(0,2)
            RC(0,3) RC(0,4) RC(0,5)
            RC(0,6) RC(0,7)
        >;
    };

    ninekey_layout: ninekey_layout {
        compatible = "zmk,physical-layout";
        display-name = "NineKey front (K1-K8)";
        kscan = <&ninekey_scan>;
        transform = <&default_transform>;

        // Order: K1 K2 K3 / K4 K5 K6 / K7 [gap] K8. 100 = 1 key unit.
        keys = <&key_physical_attrs 100 100   0   0 0 0 0>
             , <&key_physical_attrs 100 100 100   0 0 0 0>
             , <&key_physical_attrs 100 100 200   0 0 0 0>
             , <&key_physical_attrs 100 100   0 100 0 0 0>
             , <&key_physical_attrs 100 100 100 100 0 0 0>
             , <&key_physical_attrs 100 100 200 100 0 0 0>
             , <&key_physical_attrs 100 100   0 200 0 0 0>
             , <&key_physical_attrs 100 100 200 200 0 0 0>
             ;
    };

    chosen {
        zmk,kscan = &ninekey_scan;
        zmk,physical-layout = &ninekey_layout;
    };
};
